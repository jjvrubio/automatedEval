{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv_arm64/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/01_Educativa/0101_UNIR/AutomatedEval",
    "${workspaceFolder}/01_Educativa/0101_UNIR/AutomatedEval/Grading/UNIR Grading"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnusedImport": "warning",
    "reportUnusedVariable": "warning"
  },
  "[python]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "workbench.colorTheme": "Light+",
  "workbench.preferredDarkColorTheme": "Dark+",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true
  },
  "search.exclude": {
    "**/venv_arm64": true,
    "**/venv_intel": true,
    "**/__pycache__": true
  },
  "chat.tools.terminal.autoApprove": {
    ".": true,
    "osascript": true,
    "/^python3 move_sent_messages\\.py --app mail --account \"convercus\" --source \"Elementos enviados\" --dest \"Por Apollo\" --subject-contains \"Convercus e o seu\" --dry-run$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "printf": true,
    "test": true
  }
}
