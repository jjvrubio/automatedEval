# Configuración del Analista Fantasma
# 
# Copia este archivo a .env y completa con tus claves reales.
# NO VERSIONAR ESTE ARCHIVO (debe estar en .gitignore)

# SerpAPI - Para búsquedas de Google
# Obtener en: https://serpapi.com/manage-api-key
MI_CLAVE_API_SERPAPI=tu_clave_serpapi_aqui

# Google AI (Gemini) - Para análisis con LLM
# Obtener en: https://makersuite.google.com/app/apikey
MI_CLAVE_API_GEMINI=tu_clave_gemini_aqui

# Configuración opcional (descomentar si necesario)
# OPENAI_API_KEY=tu_clave_openai  # Para comparativas
# ANTHROPIC_API_KEY=tu_clave_claude  # Análisis alternativo
