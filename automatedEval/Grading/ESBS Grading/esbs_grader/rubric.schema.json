{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ESBS/AMOS Rubric Schema",
    "type": "object",
    "required": [
        "criteria"
    ],
    "properties": {
        "criteria": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "object",
                    "required": [
                        "default_score",
                        "default_comment"
                    ],
                    "properties": {
                        "default_score": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                        },
                        "default_comment": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "clarification_questions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "additionalProperties": false
}